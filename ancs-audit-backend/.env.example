# ============================================================
# ANCS Audit Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# Ne jamais commiter .env dans le dépôt Git !
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=ancs_audit
POSTGRES_USER=ancs_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- MinIO ---
MINIO_ROOT_USER=ancs_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_ENDPOINT=http://localhost:9000

# --- pgAdmin ---
PGADMIN_EMAIL=admin@ancs.gov.tn
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# --- JWT ---
JWT_SECRET=CHANGE_ME_base64_encoded_256bit_secret_key_here
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# --- Firebase FCM (chemin vers le fichier de service account JSON) ---
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# --- IA / Ollama ---
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=mistral
AI_OLLAMA_TIMEOUT_SECONDS=60

# --- OpenAI (désactivé par défaut — voir AiConfig.java pour avertissements) ---
OPENAI_API_KEY=
OPENAI_ENABLED=false

# --- Application ---
APP_BASE_URL=https://api.ancs.gov.tn
APP_REPORT_SIGNED_URL_EXPIRY_HOURS=24
APP_MINIO_BUCKET_RAPPORTS=ancs-rapports
APP_MINIO_BUCKET_PREUVES=ancs-preuves
